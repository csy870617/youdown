{
  "name": "youdown",
  "version": "1.0.0",
  "description": "YouTube 영상/음원 다운로더 - 링크만 입력하면 영상 또는 음원으로 저장",
  "type": "module",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "pkg . --no-bytecode --public-packages \"*\" --public --out-path dist",
    "build:linux": "pkg . --no-bytecode --public-packages \"*\" --public --targets node22-linux-x64 --out-path dist",
    "build:mac": "pkg . --no-bytecode --public-packages \"*\" --public --targets node22-macos-x64 --out-path dist",
    "build:win": "pkg . --no-bytecode --public-packages \"*\" --public --targets node22-win-x64 --out-path dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  }
}
